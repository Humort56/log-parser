# Virtual environments
.venv/
venv/
env/

# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Packaging artifacts
build/
dist/
*.egg-info/

# Runtime state produced by this module. The SQLite occurrence store and the
# Drain3 template snapshot are rebuildable local data, never source.
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
drain3.bin
*.drain3.bin
# Sidecar fingerprint written next to the snapshot, recording the mining config
# it was built with. Rebuilt on save, like the snapshot itself.
*.bin.config

# Drain3 reads drain3.ini from the working directory. The module passes an
# explicit config so it is ignored, but keep stray local copies out of the repo.
drain3.ini

# Streamlit writes local config/credentials here
.streamlit/

# Claude Code: keep shared project settings, ignore personal overrides
.claude/settings.local.json

# Editor / OS noise
.idea/
.vscode/
*.swp
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
